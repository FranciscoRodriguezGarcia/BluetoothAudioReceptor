<Window x:Class="BluetoothAudioReceptor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bluetooth Audio Receptor" Height="495" Width="720"
        MinWidth="580" MinHeight="430" WindowStartupLocation="CenterScreen"
        Background="#111827" Foreground="#F3F4F6">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Bluetooth Audio Receptor" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="La PC recibe audio Bluetooth; la consola debe actuar como fuente."
                       Foreground="#9CA3AF" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="15" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="1. Hacé detectable esta PC desde Windows" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="Abrí Configuración Bluetooth y habilitá la detección de dispositivos. Esta app no puede anunciar por sí sola un perfil de auriculares A2DP; la conexión depende de los perfiles Bluetooth de Windows."
                           TextWrapping="Wrap" Foreground="#D1D5DB" Margin="0,6,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Abrir Bluetooth de Windows" Click="SettingsButton_Click"/>
                    <Button Content="Opciones Bluetooth clásicas" Click="AdvancedSettingsButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="2. Emparejá la fuente con Windows; los endpoints compatibles aparecerán aquí automáticamente"
                   TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <Border Grid.Row="3" Background="#1F2937" CornerRadius="8" Padding="12">
            <DockPanel>
                <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="Esperando dispositivos A2DP emparejados..."
                           Foreground="#9CA3AF" Margin="5" TextWrapping="Wrap"/>
                <ListBox x:Name="DeviceList" Background="Transparent" Foreground="White"
                         BorderThickness="0" SelectionChanged="DeviceList_SelectionChanged"
                         DisplayMemberPath="Name" FontSize="15"/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,12">
            <Button x:Name="EnableButton" Content="Habilitar recepción" Click="EnableButton_Click" IsEnabled="False"/>
            <Button x:Name="ConnectButton" Content="Conectar audio" Click="ConnectButton_Click" IsEnabled="False"/>
            <Button x:Name="DisconnectButton" Content="Liberar receptor" Click="DisconnectButton_Click" IsEnabled="False"/>
            <Button x:Name="RefreshButton" Content="Actualizar lista" Click="RefreshButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="5">
            <TextBlock x:Name="StatusText" Text="Iniciando escucha de dispositivos..."
                       Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,0,0,7"/>
            <TextBlock FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap"
                       Text="La Switch requiere un receptor detectable con perfil A2DP y codec SBC. Que aparezca un endpoint no garantiza que Windows pueda abrir audio. La PS3 no envía audio de juegos por A2DP."/>
        </StackPanel>
    </Grid>
</Window>
